{
  "Bms": {
    "Environment": "azure",
    "ClusterMode": "Azure",
    "ReverseProxyEnabled": true, // Azure: prefer reverse-proxy
    "DbProvider": "Postgres", // flip to "SqlServer" later via parameter only
    "PostgresConnection": "__KV:PostgresUsersConn__", // will be injected via SF param/env
    "SqlServerConnection": "__KV:SqlUsersConn__",
    "PublicBaseUrl": "https://<cluster-dns>:19081/bookmyshow-sf/UserService"
  },
  "Jwt": {
    "Issuer": "bms",
    "Audience": "bms-users",
    "Secret": "__KV:JwtSecret__"
  }
}